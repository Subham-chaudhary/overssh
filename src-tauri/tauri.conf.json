{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OverSSH",
  "mainBinaryName": "overssh",
  "version": "1.4.0",
  "identifier": "dev.overssh.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OverSSH",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Browse, edit and open terminals on VMs over plain SSH/SFTP",
    "longDescription": "OverSSH is a desktop app to browse, edit and open terminals on remote machines over plain SSH and SFTP. Nothing is installed on the server.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "net"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
